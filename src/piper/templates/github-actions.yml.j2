# Generated by piper {{ version }}. Re-run `piper generate` after changing the stack.
name: {{ workflow_name }}

on:
  push:
    branches: [{{ default_branch }}]
  pull_request:

concurrency:
  group: ${{ '{{' }} github.workflow {{ '}}' }}-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

jobs:
{%- for job in jobs %}
  {{ job.id }}:
    name: {{ job.name }}
    runs-on: ubuntu-latest
    {%- if job.matrix %}
    strategy:
      fail-fast: false
      matrix:
        {{ job.matrix.key }}: [{{ job.matrix.options | join(', ') }}]
    {%- endif %}
    steps:
      - uses: actions/checkout@v4
      {%- for step in job.steps %}
      - name: {{ step.name }}
        {%- if step.uses %}
        uses: {{ step.uses }}
        {%- if step.params %}
        with:
          {%- for key, value in step.params.items() %}
          {{ key }}: {{ value }}
          {%- endfor %}
        {%- endif %}
        {%- else %}
        run: {{ step.run }}
        {%- endif %}
      {%- endfor %}
{%- endfor %}
